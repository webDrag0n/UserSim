# ============================================================
# UserSim · LLM 接入配置
# 本文件只回答一个问题：模型从哪来。
#   - provider 端点 / 密钥 / 模型名 / 采样参数（[providers.*]）
#   - 调用运行时（[runtime]）
# 各 agent 用哪个 provider 由 agent 自己的 config.toml 决定
# （agents/user/config.toml、agents/assistant/config.toml 的 [llm] 节，
#  只写 provider 引用与覆盖，密钥仍在本文件或环境变量）。
# 系统行为参数（世界动力学、评估阈值等）请改 config/system.toml。
#
# 安全约定：
#   1. 本文件包含密钥，禁止提交进任何公开仓库（已在 .gitignore）。
#   2. 所有 api_key 均可用同名环境变量覆盖，优先级高于文件：
#      例如 USERSIM_OPENAI_API_KEY、USERSIM_MOONSHOT_API_KEY。
# ============================================================

# ------------------------------------------------------------
# Provider 定义：全部走 OpenAI 兼容协议（/v1/chat/completions）
# ------------------------------------------------------------

[providers.moonshot]
base_url    = "https://api.moonshot.cn/v1"
api_key     = "sk-在此填入你的-Moonshot-Key"
model       = "kimi-k2-0905-preview"
temperature = 0.7
max_tokens  = 4096

[providers.openai]
base_url    = "https://api.openai.com/v1"
api_key     = "sk-在此填入你的-OpenAI-Key"
model       = "gpt-4o"
temperature = 0.7
max_tokens  = 4096

[providers.deepseek]
base_url    = "https://api.deepseek.com/v1"
api_key     = "sk-在此填入你的-DeepSeek-Key"
model       = "deepseek-chat"
temperature = 0.7
max_tokens  = 4096

# 本地或自建 OpenAI 兼容端点（vLLM / Ollama / LMStudio 等）
[providers.local]
base_url    = "http://127.0.0.1:8000/v1"
api_key     = "not-needed"
model       = "your-local-model"
temperature = 0.7
max_tokens  = 4096

# ------------------------------------------------------------
# 调用运行时
# ------------------------------------------------------------

[runtime]
timeout_s    = 60     # 单次请求超时
max_retries  = 3      # 失败重试（指数退避）
concurrency  = 8      # 进程级 LLM 并发上限（模块级信号量，多 episode/多角色共享）
log_prompts  = false  # 是否在运行日志中保存完整 prompt（调试用，体积大）
